PORT=5000
MONGO_URI=mongodb://localhost:27017/edunix
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local Ollama AI Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Online AI Settings (Optional: Gemini, OpenAI, or n8n webhook/custom endpoint)
ONLINE_AI_PROVIDER=gemini
ONLINE_AI_MODEL=gemini-1.5-flash
ONLINE_AI_API_KEY=your_gemini_or_openai_api_key_here
ONLINE_AI_URL=
# Primary Online AI - n8n Agentic AI Webhook
N8N_LEARNING_AGENT_URL=https://exampleName.app.n8n.cloud/webhook/learning-agent
